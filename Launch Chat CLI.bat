title JW Terminal Chat - Cursiv v3.0
cd /d "%~dp0"

if exist "%~dp0secrets.bat" (
    call "%~dp0secrets.bat"
) else (
    echo  [!] secrets.bat not found - enter keys manually inside the chat.
)

:: Quick dep check
